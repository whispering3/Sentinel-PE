{
  "name": "sentinel-pe",
  "version": "0.3.0",
  "author": "Sentinel PE Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/whispering3/Sentinel-PE.git"
  },
  "homepage": "https://github.com/whispering3/Sentinel-PE#readme",
  "private": true,
  "description": "Local-first defensive Windows PE triage workbench and opt-in endpoint guard — static analysis, ransomware & infostealer heuristics, YARA/Sigma generation.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 tsx electron/main.ts",
    "build": "tsc -p tsconfig.electron.json && tsc -b && vite build",
    "start": "electron .",
    "test": "vitest",
    "test:run": "vitest run",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "dist:nsis": "npm run build && electron-builder --win nsis --x64",
    "dist:zip": "npm run build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "io.sentinelpe.app",
    "productName": "Sentinel PE",
    "copyright": "Copyright © 2026 Sentinel PE Contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] },
        { "target": "zip",      "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sentinel PE",
      "artifactName": "${productName}-Setup-${version}-x64.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-x64.${ext}"
    },
    "publish": null
  }
}
